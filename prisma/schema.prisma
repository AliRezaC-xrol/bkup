generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row (id = 1) holding all bot configuration
model BackupConfig {
  id               Int      @id @default(1)
  // LEGACY (v3.0): kept only for one-time auto-migration to the per-panel flags below
  panelType        String   @default("3x-ui")
  // ── Panel 1: 3x-ui (MHSanaei) — independent connection ──
  xuiEnabled       Boolean  @default(true)
  panelUrl         String   @default("")
  panelBasePath    String   @default("")
  panelUsername    String   @default("")
  panelPassword    String   @default("")
  authMode         String   @default("session") // session | bearer
  apiToken         String   @default("") // v3 admin API token (Bearer)
  skipTlsVerify    Boolean  @default(true)
  // ── Panel 2: HMPanel (neoauroraproject) — fully independent connection ──
  hmEnabled        Boolean  @default(false)
  hmUrl            String   @default("")
  hmUsername       String   @default("")
  hmPassword       String   @default("")
  // ── Panel 3: PasarGuard — fully independent connection ──
  pgEnabled        Boolean  @default(false)
  pgUrl            String   @default("")
  pgUsername       String   @default("")
  pgPassword       String   @default("")
  // HM Panel edition — detected from the panel's own health payload
  hmPremium        Boolean  @default(false)
  // ── Panel 4: Rebecca — fully independent connection ──
  rebeccaEnabled   Boolean  @default(false)
  rebeccaUrl       String   @default("")
  rebeccaUsername  String   @default("")
  rebeccaPassword  String   @default("")
  // ── Custom paths — arbitrary directories on THIS server backed up as
  //    tar.gz alongside the panel backups (e.g. /opt/myapp, /etc/nginx) ──
  customPaths      String   @default("[]") // JSON array of absolute paths
  // Telegram (shared destination for BOTH panels)
  telegramApiBase  String   @default("https://api.telegram.org")
  telegramBotToken String   @default("")
  telegramChatId   String   @default("")
  telegramThreadId String   @default("")
  // Scheduling
  intervalSeconds  Int      @default(60)
  enabled          Boolean  @default(false)
  // Backup behavior
  backupMode       String   @default("db") // legacy since 1.2.0 — 3x-ui always takes the full database backup
  localDbPath      String   @default("") // legacy since 1.2.0 — unused
  localRetention   Int      @default(288) // keep last N local files (0 = unlimited)
  tgAutoDeleteKeep Int      @default(0) // keep last N tg messages (0 = never delete)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Singleton row (id = 1) holding web-panel security configuration
model SystemConfig {
  id              Int      @id @default(1)
  passwordHash    String   @default("") // scrypt hash of panel password
  passwordSalt    String   @default("")
  sessionSecret   String   @default("") // HMAC key for session tokens
  sessionsVersion Int      @default(0) // bump to invalidate all sessions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One row per backup execution
model BackupRun {
  id            Int       @id @default(autoincrement())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String // running | success | failed
  trigger       String // auto | manual
  panel         String    @default("3x-ui") // 3x-ui | hmpanel | pasarguard — which panel this run belongs to
  method        String? // db | json | local | hm-full | pg-full | custom-full
  fileName      String?
  filePath      String?
  fileSize      Int?
  sourcePath    String? // custom-path backups: the directory this archive was taken from
  tgMessageId   Int?
  tgMessageIds  String? // JSON array — ALL message ids (multi-part sends)
  tgDeleted     Boolean  @default(false)
  error         String?
  durationMs    Int?

  @@index([startedAt])
}

// Reassembled backups — parts uploaded in the web panel and merged back
// into the one complete original archive
model ReassembledBackup {
  id        Int      @id @default(autoincrement())
  name      String // output (original) file name
  panel     String   @default("") // best-effort panel hint parsed from the names
  parts     Int      @default(1)
  size      Int
  filePath  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// System log entries shown in the live log console
model AppLog {
  id      Int      @id @default(autoincrement())
  ts      DateTime @default(now())
  level   String // info | success | warn | error
  message String

  @@index([ts])
}

// Singleton row (id = 1) holding restore feature configuration
model RestoreConfig {
  id              Int      @id @default(1)
  // Install script URLs for each panel — defaults to official repos.
  // The user can override each with their own GitHub URL.
  xuiInstallScript String  @default("https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh")
  hmInstallScript  String  @default("https://raw.githubusercontent.com/neoauroraproject/hmpanel/main/install.sh")
  pgInstallScript  String  @default("https://raw.githubusercontent.com/PasarGuard/panel/main/install.sh")
  rbInstallScript  String  @default("https://raw.githubusercontent.com/rebeccapanel/Rebecca/main/install.sh")
  // GitHub token for private repos (optional, used when fetching install scripts)
  githubToken      String  @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One row per restore execution
model RestoreJob {
  id           Int      @id @default(autoincrement())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String   // running | success | failed
  panel        String   // 3x-ui | hmpanel | pasarguard | rebecca
  backupId     Int?     // id of the BackupRun or ReassembledBackup
  backupName   String?
  backupSource String   // backup-run | reassembled
  backupPath   String?  // local file path of the backup
  sshHost      String
  sshPort      Int
  sshUser      String
  error        String?
  durationMs   Int?
  steps        String?  // JSON array of step progress objects

  @@index([startedAt])
}
